{
  "manifest_version": 3,
  "name": "Dictate",
  "description": "Voice dictation helper for ChatGPT, plus Teams live-caption bridge to ChatGPT.",
  "version": "1.6.2",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "webNavigation", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.teams.cloud.microsoft/*",
    "http://127.0.0.1:38473/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dictate"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.teams.cloud.microsoft/*"
      ],
      "js": ["teams-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
