{
  "manifest_version": 3,
  "name": "ChatGPT Auto-Dictate & Teams Bridge",
  "description": "Auto-send ChatGPT dictation, and forward Teams meeting voice (live captions + mic) to ChatGPT for answers.",
  "version": "1.3.2",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Auto-Dictate"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://teams.microsoft.com/*"],
      "js": ["teams-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
